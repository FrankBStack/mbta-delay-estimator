# opc's crontab on the box (UTC). Install with: crontab deploy/crontab
# 03:30 daily: dump the rollup and the last two days of arrivals, upload if BACKUP_URL is set
30 3 * * * cd /opt/tracker && ./deploy/backup.sh >> backup.log 2>&1
# Monday 04:00: reload the static feed (staged and swapped, no outage)
0 4 * * 1 cd /opt/tracker && docker compose run --rm load >> load.log 2>&1
