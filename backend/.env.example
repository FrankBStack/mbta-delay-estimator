DATABASE_URL=postgresql://localhost:5432/tracker

GTFS_STATIC_URL=https://cdn.mbta.com/MBTA_GTFS.zip
VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb

POLL_INTERVAL_S=15
AGENCY_TZ=America/New_York

# NAD83 / Massachusetts Mainland. Change this if you point at another city.
PROJECTED_SRID=26986

MAX_SNAP_ERROR_M=150

# RETENTION_HOURS covers positions and observations; trip_update uses this one.
RETENTION_HOURS=48
BACKFILL_HOURS=24

# Must list the real origin in production, unless the API and the built
# frontend are served from one origin behind a reverse proxy.
CORS_ORIGINS=http://localhost:5173

# false on the API when the poller runs separately (`python -m app.poller`).
# Leaving it true on more than one replica means N pollers writing the same rows.
RUN_POLLER=true

ENABLE_DOCS=true

DB_POOL_MIN=2
DB_POOL_MAX=10

# Response cache. 0 disables it.
CACHE_TTL_S=5
CACHE_MAX_ENTRIES=512
